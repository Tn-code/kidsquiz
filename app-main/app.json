{
  "expo": {
    "name": "QuizApp",
    "slug": "quizapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devapptn.quizapp"
    },
    "android": {
      "package": "com.devapptn.quizapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "34.0.0",
            "minSdkVersion": 23,
            "gradleVersion": "8.13",
            "kotlinVersion": "2.1.20"
          }
        }
      ]
    ]
  }
}
